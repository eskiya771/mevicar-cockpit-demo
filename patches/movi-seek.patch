+++ b/src/source/HttpSource.size.test.ts
@@ -0,0 +1,170 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createServer, type Server } from "node:http";
+import type { AddressInfo } from "node:net";
+import { HttpSource } from "./HttpSource";
+
+const MiB = 1024 * 1024;
+const filmSize = 1570800962;
+const sources: HttpSource[] = [];
+const servers: Server[] = [];
+afterEach(async () => {
+  for (const source of sources.splice(0)) source.close();
+  for (const server of servers.splice(0)) {
+    server.closeAllConnections();
+    await new Promise<void>(resolve => server.close(() => resolve()));
+  }
+  vi.unstubAllGlobals();
+});
+
+function source(url = "https://size.test/film.mkv") {
+  vi.stubGlobal("crossOriginIsolated", false);
+  const value = new HttpSource(url, {}, 50);
+  sources.push(value);
+  return value;
+}
+
+function answer(headers: Record<string, string>, status = 200) {
+  return new Response(null, { status, headers });
+}
+
+describe("HTTP size discovery", () => {
+  it.each(["0", "123bytes", "-1", "9007199254740992"])(
+    "recovers an unusable HEAD length %s with one bounded range",
+    async value => {
+      const fetcher = vi.fn(async (_url: unknown, init?: RequestInit) =>
+        init?.method === "HEAD"
+          ? answer({ "Content-Length": value })
+          : answer({ "Content-Length": "1", "Content-Range": `bytes 0-0/${filmSize}` }, 206));
+      vi.stubGlobal("fetch", fetcher);
+      const s = source();
+      expect(await s.getSize()).toBe(filmSize);
+      expect(await s.getSize()).toBe(filmSize);
+      expect(fetcher).toHaveBeenCalledTimes(2);
+      expect(new Headers(fetcher.mock.calls[1][1]?.headers).get("Range")).toBe("bytes=0-0");
+      expect(s.getReadDiagnostics().bufferCapacityBytes).toBe(50 * MiB);
+    },
+  );
+
+  it("keeps a valid full HEAD response at one request", async () => {
+    const fetcher = vi.fn(async () => answer({ "Content-Length": String(filmSize) }));
+    vi.stubGlobal("fetch", fetcher);
+    expect(await source().getSize()).toBe(filmSize);
+    expect(fetcher).toHaveBeenCalledTimes(1);
+  });
+
+  it("uses the total, not Content-Length, for a partial HEAD response", async () => {
+    const fetcher = vi.fn(async () =>
+      answer({ "Content-Length": "1", "Content-Range": `bytes 0-0/${filmSize}` }, 206));
+    vi.stubGlobal("fetch", fetcher);
+    expect(await source().getSize()).toBe(filmSize);
+    expect(fetcher).toHaveBeenCalledTimes(1);
+  });
+
+  it("probes a partial HEAD response that has no total", async () => {
+    const fetcher = vi.fn(async (_url: unknown, init?: RequestInit) =>
+      init?.method === "HEAD" ? answer({ "Content-Length": "1" }, 206)
+        : answer({ "Content-Length": "1", "Content-Range": `bytes 0-0/${filmSize}` }, 206));
+    vi.stubGlobal("fetch", fetcher);
+    expect(await source().getSize()).toBe(filmSize);
+    expect(fetcher).toHaveBeenCalledTimes(2);
+  });
+
+  it("uses full GET headers if a ranged response cannot name its total", async () => {
+    const fetcher = vi.fn(async (_url: unknown, init?: RequestInit) => {
+      if (init?.method === "HEAD") return answer({ "Content-Length": "0" });
+      if (new Headers(init?.headers).has("Range")) {
+        return answer({ "Content-Length": "1", "Content-Range": "bytes 0-0/*" }, 206);
+      }
+      return answer({ "Content-Length": String(filmSize) });
+    });
+    vi.stubGlobal("fetch", fetcher);
+    const s = source();
+    expect(await s.getSize()).toBe(filmSize);
+    expect(fetcher).toHaveBeenCalledTimes(3);
+    expect(s.getReadDiagnostics().sizeSource).toBe("get");
+  });
+
+  it("cancels an ignored Range body and uses its complete length without another GET", async () => {
+    const cancel = vi.fn();
+    const fetcher = vi.fn(async (_url: unknown, init?: RequestInit) =>
+      init?.method === "HEAD" ? answer({ "Content-Length": "0" })
+        : new Response(new ReadableStream({ cancel }), {
+          status: 200, headers: { "Content-Length": String(filmSize) },
+        }));
+    vi.stubGlobal("fetch", fetcher);
+    const s = source();
+    expect(await s.getSize()).toBe(filmSize);
+    expect(fetcher).toHaveBeenCalledTimes(2);
+    expect(cancel).toHaveBeenCalledOnce();
+    expect(s.getReadDiagnostics().sizeSource).toBe("range-ignored");
+  });
+
+  it.each(["bytes 0-10/10", "bytes 0-0/9007199254740992", "bytes 2-1/10"])(
+    "does not trust an invalid Content-Range %s or its partial length",
+    async contentRange => {
+      const cancel = vi.fn();
+      const fetcher = vi.fn(async (_url: unknown, init?: RequestInit) => {
+        if (init?.method === "HEAD") return answer({ "Content-Length": "0" });
+        if (new Headers(init?.headers).has("Range")) {
+          return new Response(new ReadableStream({ cancel }), {
+            status: 206, headers: { "Content-Length": "1", "Content-Range": contentRange },
+          });
+        }
+        return answer({ "Content-Length": String(filmSize) });
+      });
+      vi.stubGlobal("fetch", fetcher);
+      expect(await source().getSize()).toBe(filmSize);
+      expect(fetcher).toHaveBeenCalledTimes(3);
+      expect(cancel).toHaveBeenCalledOnce();
+    },
+  );
+
+  it("rejects a zero size from a custom resolver without caching it", async () => {
+    class EmptySource extends HttpSource {
+      protected async resolveSize() { return 0; }
+    }
+    const s = new EmptySource("https://size.test/empty", {}, 50);
+    sources.push(s);
+    await expect(s.getSize()).rejects.toThrow("file size");
+    expect(s.getKnownSize()).toBe(-1);
+  });
+
+  it("replaces the reported 1.8 MiB restart pattern over a real HTTP connection", async () => {
+    const ranges: Array<{ start: number; end: number }> = [];
+    const server = createServer((req, res) => {
+      if (req.method === "HEAD") {
+        res.writeHead(200, { "Content-Length": "0" });
+        res.end();
+        return;
+      }
+      const range = /^bytes=(\d+)-(\d+)$/.exec(req.headers.range || "");
+      if (!range) { res.writeHead(400); res.end(); return; }
+      const start = Number(range[1]), end = Number(range[2]);
+      ranges.push({ start, end });
+      res.writeHead(206, {
+        "Content-Length": end - start + 1,
+        "Content-Range": `bytes ${start}-${end}/${filmSize}`,
+      });
+      res.end(Buffer.alloc(end - start + 1, 0x5a));
+    });
+    servers.push(server);
+    await new Promise<void>(resolve => server.listen(0, "127.0.0.1", resolve));
+    const s = source(`http://127.0.0.1:${(server.address() as AddressInfo).port}/film.mkv`);
+    const size = await s.getSize();
+    const data = new Uint8Array(await s.read(100 * MiB, 512 * 1024));
+    const opening = ranges.find(r => r.start === 100 * MiB)!;
+    expect({
+      size,
+      openingRangeBytes: opening.end - opening.start + 1,
+      bytesRead: data.length,
+    }).toEqual({ size: filmSize, openingRangeBytes: 4 * MiB, bytesRead: 512 * 1024 });
+    expect(data[0]).toBe(0x5a);
+    expect(data[data.length - 1]).toBe(0x5a);
+    expect(s.getReadDiagnostics()).toEqual({
+      fileSizeBytes: filmSize,
+      bufferCapacityBytes: 50 * MiB,
+      headContentLength: "0",
+      sizeSource: "range",
+    });
+  });
+});
