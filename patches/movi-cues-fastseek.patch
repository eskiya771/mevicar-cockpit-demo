diff --git a/wasm/movi_streams.c b/wasm/movi_streams.c
--- a/wasm/movi_streams.c
+++ b/wasm/movi_streams.c
@@ -851,7 +851,27 @@ int movi_seek_to(MoviContext *ctx, double timestamp, int stream_index,
   // follows then starts the decoder on a keyframe instead of a GOP of packets
   // it has to throw away.
   int ret = -1;
+  // Fast path for indexed Matroska: prefer the nearest indexed VIDEO RAP
+  // before the requested time. This avoids the general seek-file timestamp
+  // negotiation and prevents the demuxer from seeking by an audio track.
+  // Keep both existing seek implementations as fallbacks for non-indexed MKV,
+  // missing video entries, invalid positions and unusual muxers.
+  if (anchor >= 0 && movi_is_matroska(ctx)) {
+    AVStream *video = ctx->fmt_ctx->streams[anchor];
+    AVRational tb = video->time_base;
+    double seconds_per_tick = av_q2d(tb);
+    if (seconds_per_tick > 0) {
+      int64_t wanted = (int64_t)(timestamp / seconds_per_tick);
+      int idx = av_index_search_timestamp(video, wanted, AVSEEK_FLAG_BACKWARD);
+      const AVIndexEntry *entry =
+          idx >= 0 ? avformat_index_get_entry(video, idx) : NULL;
+      if (entry && entry->pos >= 0 && entry->timestamp <= wanted &&
+          (wanted - entry->timestamp) * seconds_per_tick <= 30.0) {
+        ret = av_seek_frame(ctx->fmt_ctx, anchor, entry->timestamp,
+                            AVSEEK_FLAG_BACKWARD);
+      }
+    }
+  }
