# Copy to .env on Synology only; never commit real values.
XTREAM_UPSTREAM=http://your-iptv-host.example:8080
XTREAM_USER=replace-locally
XTREAM_PASSWORD=replace-locally
# Generate locally: openssl rand -hex 32
MEVITV_BRIDGE_TOKEN=replace-with-random-64-character-hex-token
# Origin is scheme + hostname only, no path/trailing slash
MEVITV_ORIGIN=https://eskiya771.github.io

# Optional four-digit PIN for short-lived MeviTV browser login. Set ONLY in private Synology .env.
MEVITV_PIN=replace-with-private-four-digit-pin

# Public CDN redirects are validated automatically from Proxy Build 8.
MEVITV_VOD_REDIRECT_MODE=public
# Optional legacy mode: set MODE to allowlist and list explicitly trusted hosts.
# MEVITV_VOD_REDIRECT_HOSTS=cdn.example,another-cdn.example
